# ============================================================
#  GrafCenter — Variáveis de Ambiente
#  Copie para .env e ajuste os valores
# ============================================================

# --- Banco de dados (obrigatório) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Aplicação Web ---
NODE_ENV=production
PORT=3000

# ============================================================
#  CENTRAL DE COMUNICAÇÃO — EMAIL TRANSACIONAL
# ============================================================
# Configure somente depois de verificar o domínio no Resend (SPF/DKIM/DMARC).
RESEND_API_KEY=
EMAIL_FROM=VTDigital Art Studio <atendimento@seudominio.com.br>
# Segredo Svix recebido ao criar webhook no Resend.
RESEND_WEBHOOK_SECRET=
# Worker opcional: padrão 2500ms.
EMAIL_WORKER_POLL_MS=2500

# --- Alternativa SMTP (use somente se o canal Email estiver configurado como smtp) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VTDigital Art Studio <atendimento@seudominio.com.br>

# ============================================================
#  CENTRAL DE COMUNICAÇÃO — WHATSAPP BAILEYS
# ============================================================
# IMPORTANTE: Baileys usa WhatsApp Web e não é API oficial da Meta.
# Rode scripts/whatsapp-gateway.mjs como processo separado com volume persistente.
WHATSAPP_AUTH_DIR=./data/whatsapp-auth
WHATSAPP_LOG_LEVEL=info
WHATSAPP_MIN_DELAY_MS=2500
WHATSAPP_MAX_DELAY_MS=6500
WHATSAPP_MAX_NEW_CONVERSATIONS_PER_DAY=30
# Opcional: lista de números permitidos para mensagens recebidas.
# Use * para receber de todos. Em produção, prefira allowlist explícita.
WHATSAPP_ALLOWLIST=*

# ============================================================
#  INTEGRAÇÕES LEGADAS / EXTERNAS
#  Mantidas durante a migração; não usar para novos fluxos.
# ============================================================
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# --- VoIP / PABX (click-to-call) ---
VOIP_TOKEN=
VOIP_API_URL=

# --- Portal de Clientes ---
PORTAL_TOKEN=
