# ============================================================
#  GrafCenter — Variáveis de Ambiente
#  Copie para .env e ajuste os valores
# ============================================================

# --- Banco de dados (obrigatório) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Aplicação ---
NODE_ENV=production
PORT=3000

# ============================================================
#  INTEGRAÇÕES EXTERNAS (opcionais)
#  Sistemas separados — não sobrecarregam o ERP
# ============================================================

# --- WhatsApp / E-mail transacional (sistema externo com bot) ---
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# --- VoIP / PABX (click-to-call) ---
VOIP_TOKEN=
VOIP_API_URL=

# --- Portal de Clientes (sistema externo) ---
PORTAL_TOKEN=
